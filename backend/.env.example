# Banco: SQLite local por padrão. Em produção, cole a URL do Postgres (Neon/Supabase).
DATABASE_URL=sqlite:///./radar.db

# Token que o frontend usa para ler e mover as vagas. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=troque-este-token

# true = qualquer pessoa lê as vagas (modo vitrine). Edição sempre exige token.
PUBLIC_READ=false

# Origens do frontend que podem chamar a API, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:3000

# Opcional: liga a camada de IA (casos ambíguos + nota de aderência).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MAX_PER_RUN=60
# CANDIDATE_PROFILE="Seu resumo aqui"
